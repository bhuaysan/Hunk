{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunk",
  "version": "0.0.0",
  "identifier": "app.hunk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hunk",
        "width": 1120,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "targets": "all" }
}
