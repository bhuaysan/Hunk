{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunk",
  "version": "0.1.0",
  "identifier": "app.hunk.Hunk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hunk",
        "width": 1120,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "publisher": "Hunk contributors",
    "copyright": "Copyright © 2026 Hunk contributors",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Create and manage optical CHD images",
    "longDescription": "A local workbench for discovering, creating, extracting, inspecting, and verifying optical CHD images.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/doc/hunk/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md",
          "/usr/share/applications/app.hunk.Hunk.desktop": "../packaging/app.hunk.Hunk.desktop",
          "/usr/share/icons/hicolor/512x512/apps/app.hunk.Hunk.png": "icons/icon.png",
          "/usr/share/licenses/hunk/LICENSE": "../LICENSE",
          "/usr/share/licenses/hunk/mame": "binaries/mame-mame0289-compliance",
          "/usr/share/metainfo/app.hunk.Hunk.metainfo.xml": "../packaging/app.hunk.Hunk.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/share/doc/hunk/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md",
          "/usr/share/licenses/hunk/LICENSE": "../LICENSE",
          "/usr/share/licenses/hunk/mame": "binaries/mame-mame0289-compliance"
        },
        "desktopTemplate": "../packaging/hunk.desktop.hbs"
      }
    }
  }
}
